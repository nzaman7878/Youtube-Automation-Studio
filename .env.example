# YT Automation Studio — Environment Variables Template
# Copy this file to .env before starting services

# ==============================================================================
# 1. APPLICATION CORE
# ==============================================================================
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# 2. DATABASE & CACHE
# ==============================================================================
# MongoDB with Replica Set (required for multi-document ACID transactions)
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=yt_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password_123
MONGO_INITDB_DATABASE=yt_automation_studio
MONGODB_URI=mongodb://localhost:27017/yt_automation_studio?replicaSet=rs0&directConnection=true

# Redis (BullMQ queues & caching)
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=redis_dev_secret_456
REDIS_URL=redis://:redis_dev_secret_456@localhost:6379

# ==============================================================================
# 3. N8N AUTOMATION RUNTIME
# ==============================================================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_n8n_secret_789
N8N_API_KEY=n8n_internal_api_key_placeholder

# ==============================================================================
# 4. SECURITY & CRYPTOGRAPHY (NON-NEGOTIABLE)
# ==============================================================================
# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_random_key_1
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_random_key_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Master Key for OAuth Token Encryption (64 hex characters = 32 bytes)
# Generate production key with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# 5. GOOGLE & YOUTUBE API CREDENTIALS
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/youtube/oauth2/callback
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ==============================================================================
# 6. AI PROVIDERS & LANGGRAPH
# ==============================================================================
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
